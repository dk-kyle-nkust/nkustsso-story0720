{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "Sso": "Server=lpc:localhost;Database=NkustSSO;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;",
    "LoginAuth": "",
    "LegacySsoReadOnly": ""
  },
  "IntegrationServices": {
    "SoapEnabled": false,
    "JsonEnabled": false,
    "AuthenticationSource": "campus",
    "LdapHost": "",
    "LdapPort": 636,
    "LdapBaseDn": "",
    "LdapDomain": "",
    "TimeoutSeconds": 10
  },
  "CampusAuthentication": {
    "Enabled": false,
    "DevelopmentAllowAnyPassword": false,
    "StatusIdentityTypes": {
      "02": "student",
      "01": "employee",
      "05": "employee",
      "06": "employee",
      "08": "employee"
    },
    "CommandTimeoutSeconds": 10
  },
  "Sso": {
    "StorageProvider": "SqlServer",
    "Issuer": "https://localhost:7100/",
    "Session": {
      "WindowMinutes": 60,
      "MaximumMinutes": 240
    }
  }
}
