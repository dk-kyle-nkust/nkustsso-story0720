@* 校徽、語系切換及登入登出導覽。 *@
@inject Microsoft.AspNetCore.Identity.UserManager<Account> HeaderUsers
@inject AdminAuthorizationService HeaderAccess
@{
    Context.Response.Headers.CacheControl = "no-store";
    var path = Context.Request.Path.Value ?? "/";
    var showAccount = ViewData["UserInfoInDirectory"] is not true;
    var currentUser = showAccount ? await CurrentUserDisplayService.LoadAsync(HeaderUsers, User, HeaderAccess)
        : ViewData["DirectoryCurrentUser"] as CurrentUserViewModel;
    var loginArea = LoginArea.Normalize(ViewContext.RouteData.Values["section"] as string ?? Context.Request.Query["area"].ToString());
    var loginReturn = path.StartsWith("/account/", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/connect/", StringComparison.OrdinalIgnoreCase)
        ? "/portal" : path + Context.Request.QueryString;
}
<header class="site-header">
    <div class="site-header-brand-row">
        <div class="site-header-brand">
            <a href="/portal" aria-label="國立高雄科技大學，返回專區選擇">
                <img src="/nkust-logo-horizontal.png" asp-append-version="true" alt="國立高雄科技大學" width="2048" height="379" />
            </a>
            <span class="site-header-caption">校務資訊入口</span>
        </div>
        <div class="site-header-tools">
        <div class="site-header-actions">
            <a class="site-header-home" href="https://www.nkust.edu.tw/index.php" target="_blank" rel="noopener noreferrer">回校首頁<span class="sr-only">（另開新分頁）</span></a>
            <a class="site-header-forgot" href="https://resetpassword.nkust.edu.tw/" target="_blank" rel="noopener noreferrer">忘記密碼<span class="sr-only">（另開新分頁）</span></a>
            @if (ViewData["SupportsEnglish"] is true)
            {
                <button type="button" class="site-language" data-language-switch lang="en" aria-label="Switch to English" hidden>English</button>
            }
        </div>
        @if (showAccount)
        {
            <partial name="_CurrentUser" model="currentUser" />
        }
        </div>
    </div>
    <div class="site-header-navigation">
        <div class="site-header-nav-inner">
            <button type="button" class="site-nav-toggle" aria-controls="site-navigation" aria-expanded="false" hidden><span aria-hidden="true">☰</span> 專區選單</button>
            <nav id="site-navigation" aria-label="主要導覽">
                <a href="/portal/student" aria-current="@(path == "/portal/student" ? "page" : null)">學生專區</a>
                <a href="/portal/employee" aria-current="@(path == "/portal/employee" ? "page" : null)">教職員專區</a>
                <a href="/portal/alumni" aria-current="@(path == "/portal/alumni" ? "page" : null)">校友專區</a>
                <a href="/faq" aria-current="@(path == "/faq" ? "page" : null)">常見問題</a>
                @* 管理入口從帳號面板移到專區導覽。常駐渲染只切換 hidden，
                   header.js 才能在跨分頁登入或角色撤銷時即時更新，不靠重新整理。 *@
                <a class="site-nav-admin" data-manage-systems href="/admin" hidden="@(currentUser?.CanManageSystems != true)"><span aria-hidden="true">⚙</span><span>後台管理</span></a>
            </nav>
            <div class="site-nav-account">
                <a class="site-nav-signin" data-account-login hidden="@(currentUser is not null)" href="@Url.Action("Login", "AccountLogin", new { area = loginArea, returnUrl = loginReturn })">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M3 12h12m-4-4 4 4-4 4"/></svg>
                    <span>登入</span>
                </a>
                <form action="/account/logout" method="post" data-header-logout hidden="@(currentUser is null)">
                    @Html.AntiForgeryToken()
                    <button class="site-nav-signout" type="submit">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 4H4a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5m3-8h9m-4-4 4 4-4 4"/></svg>
                        <span>登出</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
