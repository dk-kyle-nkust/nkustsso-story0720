@* 帳密登入表單及帳號使用說明。 *@
@model LoginViewModel
@{
    ViewData["SupportsEnglish"] = true;
    var areaLabel = LoginArea.Label(Model.Area);
    var alumni = Model.Area == "alumni";
    ViewData["Title"] = Model.Area.Length == 0 ? areaLabel : areaLabel + "登入";
    ViewData["HideAccountNavigation"] = true;
}

@section head { <link rel="stylesheet" href="/login.css" asp-append-version="true" /> }
<div class="login-center-wrapper login-area-@Model.Area">
    <section class="login-surface" aria-labelledby="login-title">
        <div class="login-card-box">
            <div class="login-card-heading">
                <p class="login-identity">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M6 16c0-4 6-4 6 0M15 10h3M15 14h3"/></svg>
                    <span>@areaLabel</span>
                </p>
                <h1 id="login-title">校園帳號登入</h1>
            </div>
            @if (Model.DevelopmentAllowAnyPassword)
            {
                <p class="muted login-card-sub" role="note"><strong>開發測試模式</strong>：請輸入存在的校園帳號，密碼填任意非空白內容即可登入。</p>
            }
            else
            {
            <p class="muted login-card-sub">@(Model.Area switch {
                "student" => "請使用校務系統的學號與密碼登入。",
                "employee" => "請使用教職員校園帳號與密碼登入。",
                "alumni" => "請使用仍可登入的校園帳號與密碼。",
                _ => "請使用校園帳號與密碼登入。"
            })</p>
            }

            <form method="post" action="/account/login" class="login-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <input asp-for="Area" type="hidden" />
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="validation" role="alert" tabindex="-1"></div>
                }

                <div class="form-group">
                    <label asp-for="UserName">校園帳號</label>
                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <input asp-for="UserName" autocomplete="username" placeholder="@(Model.Area == "student" ? "請輸入完整學號" : "請輸入校園帳號")" required maxlength="100" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label asp-for="Password">密碼</label>
                        <a href="https://resetpassword.nkust.edu.tw/" target="_blank" rel="noopener noreferrer" class="link-forgot-pwd" title="前往高科大密碼重設系統">
                            忘記密碼？
                        <span class="sr-only">（另開新分頁）</span></a>
                    </div>
                    <div class="input-wrap password-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input asp-for="Password" autocomplete="current-password" placeholder="請輸入密碼" required maxlength="256" />
                        <button type="button" class="pwd-toggle" id="toggle-pwd" aria-label="顯示密碼" aria-pressed="false" title="切換密碼顯示">
                            <svg class="eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                        </button>
                    </div>
                </div>

                <button class="button primary full" type="submit">
                    <span>登入</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                </button>
            </form>

            @if (alumni)
            {
                <p class="login-area-note">原帳號已停用或尚未開通時，請先查看 <a href="https://www.nkust.edu.tw/p/405-1000-45727,c7048.php" target="_blank" rel="noopener noreferrer">校方校友服務指南 ↗<span class="sr-only">（另開新分頁）</span></a>，洽詢適用的服務與帳號使用方式。</p>
            }
            <details class="login-help-details">
                <summary>帳號使用說明與服務聯絡窗口</summary>
                <div class="login-help-grid">
                <div class="help-card">
                    <div class="help-card-header">
                        <h2>帳號登入說明</h2>
                    </div>
                    <ul class="help-list">
                        <li>
                            <strong>帳號規則：</strong>依校方核發的帳號登入；學生使用完整學號，教師與職員使用教職員帳號。校友帳號須仍在有效使用範圍內。
                        </li>
                        <li>
                            <strong>密碼規則：</strong>請使用目前有效的校園帳號密碼；首次使用或無法登入時，依校方的帳號啟用與重設說明操作。
                        </li>
                        <li>
                            <strong>重設密碼：</strong>若忘記密碼或密碼遭鎖定，請至 <a href="https://resetpassword.nkust.edu.tw/" target="_blank" rel="noopener noreferrer">忘記密碼系統<span class="sr-only">（另開新分頁）</span></a> 或參閱 <a href="https://webap0.nkust.edu.tw/nkust/ResetPwdGuide-20230110.pdf" target="_blank" rel="noopener noreferrer">忘記密碼操作手冊<span class="sr-only">（另開新分頁）</span></a>。
                        </li>
                        <li>
                            <strong>瀏覽器推薦：</strong>支援 Chrome、Edge、Firefox、Safari 等現代瀏覽器最新版本。
                        </li>
                        <li>
                            <strong>相關下載：</strong><a href="https://webap0.nkust.edu.tw/nkust/115_09nkustEDU.exe" target="_blank" rel="noopener noreferrer">校務系統造字檔下載 (115/09更新)<span class="sr-only">（另開新分頁）</span></a> · <a href="http://140.133.78.49/nkust/z_barcode/barcode.exe" target="_blank" rel="noopener noreferrer">條碼字型安裝檔<span class="sr-only">（另開新分頁）</span></a>
                        </li>
                    </ul>
                </div>
        
                <div class="help-card">
                    <div class="help-card-header">
                        <h2>服務聯絡窗口</h2>
                    </div>
                    <p class="help-intro">總機電話：<strong>(07) 381-4526</strong>（各校區直撥分機）</p>
                    <div class="contact-table-wrap">
                        <table class="contact-table">
                            <caption class="sr-only">服務聯絡窗口</caption>
                            <thead><tr><th scope="col">問題</th><th scope="col">承辦單位</th><th scope="col">分機或窗口</th></tr></thead>
                            <tbody>
                                <tr>
                                    <td><strong>無法登入 / 軟體諮詢</strong></td>
                                    <td>電算中心軟體組</td>
                                    <td class="tel-ext">分機 <strong>22256</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>校務系統密碼修改</strong></td>
                                    <td>系統管理中心</td>
                                    <td class="tel-ext">分機 <strong>13162</strong></td>
                                </tr>
                                <tr>
                                    <td><strong>學籍與註冊相關</strong></td>
                                    <td><a href="https://acad.nkust.edu.tw/p/412-1004-1603.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer">教務處註冊組<span class="sr-only">（另開新分頁）</span></a></td>
                                    <td class="tel-ext">建工/燕巢/楠梓/旗津/第一</td>
                                </tr>
                                <tr>
                                    <td><strong>選課與課務相關</strong></td>
                                    <td><a href="https://acad.nkust.edu.tw/p/412-1004-1602.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer">教務處課務組<span class="sr-only">（另開新分頁）</span></a></td>
                                    <td class="tel-ext">各校區課務窗口</td>
                                </tr>
                                <tr>
                                    <td><strong>成績相關問題</strong></td>
                                    <td><a href="https://acad.nkust.edu.tw/p/412-1004-1599.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer">學習輔導組<span class="sr-only">（另開新分頁）</span></a></td>
                                    <td class="tel-ext">各校區綜合業務處</td>
                                </tr>
                                <tr>
                                    <td><strong>新生入學與報到</strong></td>
                                    <td><a href="https://acad.nkust.edu.tw/p/412-1004-1601.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer">教務處招生組<span class="sr-only">（另開新分頁）</span></a></td>
                                    <td class="tel-ext">招生諮詢窗口</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                </div>
            </details>
        </div>
    </section>
</div>

@section scripts { <script src="/login.js" asp-append-version="true" defer></script> }
