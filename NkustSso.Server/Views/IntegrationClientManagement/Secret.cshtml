@* 顯示本次新建或重設的串接密鑰。 *@
@model IntegrationClientSecretViewModel
@{ ViewData["Title"] = "串接密鑰已建立"; }
<section class="panel narrow"><h1>串接密鑰已建立</h1><p>以下密鑰僅顯示這一次，請交由串接端安全保存。</p>
<dl><dt>X-Client-Id</dt><dd><code>@Model.ClientId</code></dd><dt>X-Client-Secret</dt><dd><code id="integration-secret">@Model.Secret</code></dd></dl>
<p class="fine">伺服器只保存密鑰雜湊。請放在串接端的伺服器設定，不可放入網址、網頁 JavaScript 或版本控制。</p>
<a class="button primary" asp-action="Index" asp-route-kind="@Model.Kind">返回帳密驗證 API</a></section>
